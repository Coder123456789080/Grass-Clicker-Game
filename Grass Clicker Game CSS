body {
    margin: 0;
    background: #dcedc1;
    text-align: center;
    user-select: none;
    font-family: Arial, sans-serif;
    min-height: 100vh;
}

.header-bar {
    position: relative;
    width: 100%;
    z-index: 10;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 18px;
    min-height: 90px;
}

.header-bar h1 {
    margin: 0;
    font-size: clamp(34px, 4vw, 58px);
    text-align: center;
    line-height: 1.1;
    font-weight: 900;
    color: #4caf50;
    letter-spacing: 1px;
    -webkit-text-stroke: 2px #2e7d32;
    text-shadow: 0 4px 0 #2e7d32, 0 6px 10px rgba(0, 0, 0, 0.2);
    background: linear-gradient(180deg, #8ee36b, #4caf50 45%, #2e8b36);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}

.resource-box {
    position: fixed;
    top: 16px;
    left: 16px;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding: 12px 14px;
    background: rgba(255, 255, 255, 0.78);
    border: 3px solid rgba(0, 0, 0, 0.65);
    border-radius: 18px;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
    backdrop-filter: blur(3px);
}

#gemCount,
#grassCount {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
}

.main {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 5px;
    padding: 0 20px 40px;
}

.center-area {
    width: 100%;
    height: 360px;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 35px;
    box-sizing: border-box;
}

#grass {
    width: 245px;
    height: 245px;
    object-fit: cover;
    cursor: pointer;
    border: none !important;
    border-radius: 8px;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.18);
    filter: url(#grassWarp);
    transition: transform 0.05s ease-out;
    will-change: transform, filter;
}

#grass:hover {
    transform: scale(1.04);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.22);
}

#grass:active {
    transform: scale(0.96);
}

.shop-panel {
    width: min(900px, 92vw);
    height: 500px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.95);
    border: 4px solid #222;
    border-radius: 36px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.18),
                inset 0 2px 4px rgba(255, 255, 255, 0.9);
    overflow: hidden;
    margin: 0 auto;
}

.shop-panel h2 {
    margin: 16px 0 8px;
    font-size: 32px;
    font-weight: 800;
    color: #111;
}

.categories {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    padding: 8px 15px 12px;
    border-bottom: 3px solid #5d921e;
}

.categories button {
    width: 135px;
    height: 46px;
    margin: 0;
    cursor: pointer;
    font-size: 15px;
    font-weight: bold;
    color: #111;
    background: linear-gradient(180deg, #fff, #e9e9e9 35%, #bdbdbd 55%, #eee);
    border: 3px solid #666;
    border-radius: 16px;
    box-shadow: inset 0 2px 2px rgba(255, 255, 255, 0.9),
                inset 0 -3px 3px rgba(0, 0, 0, 0.25),
                0 4px 8px rgba(0, 0, 0, 0.35);
    transition: transform 0.15s ease, filter 0.15s ease;
}

.categories button:hover {
    transform: translateY(-2px) scale(1.04);
    filter: brightness(1.1);
}

.categories button:active {
    transform: scale(0.95);
    filter: brightness(0.75);
}

.shop-content {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 16px 28px 28px;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

.shop-content::-webkit-scrollbar {
    width: 13px;
}

.shop-content::-webkit-scrollbar-track {
    background: #eee;
    border-radius: 10px;
}

.shop-content::-webkit-scrollbar-thumb {
    background: #888;
    border-radius: 10px;
    border: 3px solid #eee;
}

.shop-content::-webkit-scrollbar-thumb:hover {
    background: #666;
}

.upgrade {
    width: 100%;
    min-height: 82px;
    margin: 10px auto;
    display: block;
    cursor: pointer;
    box-sizing: border-box;
    padding: 10px 14px;
    color: #111;
    font-size: 14px;
    line-height: 20px;
    font-weight: bold;
    background: linear-gradient(180deg, #f2e7e7, #d5cccc 25%, #b8b8b8 50%, #e8e8e8 75%, #9e9e9e);
    border: 3px solid #666;
    border-radius: 17px;
    box-shadow: inset 0 2px 2px rgba(255, 255, 255, 0.8),
                inset 0 -2px 2px rgba(0, 0, 0, 0.3),
                0 4px 8px rgba(0, 0, 0, 0.4);
    transition: transform 0.15s ease, filter 0.15s ease, box-shadow 0.15s ease;
}

.upgrade:hover {
    transform: scale(1.02);
    filter: brightness(1.1);
    box-shadow: inset 0 2px 2px rgba(255, 255, 255, 1),
                inset 0 -2px 2px rgba(0, 0, 0, 0.3),
                0 6px 12px rgba(0, 0, 0, 0.35);
}

.upgrade:active {
    transform: scale(0.97);
    filter: brightness(0.7);
    box-shadow: inset 0 3px 6px rgba(0, 0, 0, 0.4);
}

.ascend {
    width: 100%;
    min-height: 85px;
    margin: 18px auto;
    display: block;
    cursor: pointer;
    box-sizing: border-box;
    font-size: 16px;
    font-weight: bold;
    color: white;
    background: linear-gradient(180deg, #fff700, #ff9900, #a65f14);
    border: 4px solid #8a4b00;
    border-radius: 18px;
    box-shadow: inset 0 3px 5px rgba(255, 255, 255, 0.8),
                inset 0 -4px 5px rgba(0, 0, 0, 0.5),
                0 5px 12px rgba(0, 0, 0, 0.5);
    transition: transform 0.15s ease, filter 0.15s ease;
}

.ascend:hover {
    transform: scale(1.03);
    filter: brightness(1.15);
}

.ascend:active {
    transform: scale(0.97);
    filter: brightness(0.75);
}

.godCard {
    width: 100%;
    box-sizing: border-box;
    margin: 16px auto;
    padding: 18px;
    background: linear-gradient(180deg, #f6f6f6, #d9d9d9, #bcbcbc);
    border: 3px solid #666;
    border-radius: 18px;
    text-align: center;
    box-shadow: inset 0 2px 2px rgba(255, 255, 255, 0.8),
                inset 0 -2px 2px rgba(0, 0, 0, 0.3),
                0 6px 12px rgba(0, 0, 0, 0.35);
}

.godCard h3 {
    margin: 0;
    font-size: 20px;
    color: #295d29;
}

.godTitle {
    margin-top: 5px;
    font-size: 15px;
    color: #2f5d2f;
    font-weight: bold;
}

.godCost {
    margin: 15px 0;
    font-size: 18px;
    font-weight: bold;
}

.gemIcon {
    font-size: 24px;
    margin-right: 6px;
}

.godGem {
    width: 40px;
    height: 40px;
    object-fit: contain;
    transform: translateY(13px);
}

.buyGod {
    width: 100%;
    padding: 12px;
    font-size: 18px;
    font-weight: bold;
    cursor: pointer;
    border-radius: 12px;
    border: 3px solid #666;
    background: linear-gradient(180deg, #f2e7e7, #d5cccc, #b8b8b8, #e8e8e8, #9e9e9e);
    box-shadow: inset 0 2px 2px rgba(255, 255, 255, 0.8),
                inset 0 -2px 2px rgba(0, 0, 0, 0.3),
                0 4px 8px rgba(0, 0, 0, 0.4);
    transition: transform 0.15s ease, filter 0.15s ease;
}

.buyGod:hover {
    transform: scale(1.03);
    filter: brightness(1.1);
}

.buyGod:active {
    transform: scale(0.96);
}

.shop-panel p {
    color: black;
}

.floatingGrass {
    position: fixed;
    pointer-events: none;
    font-size: 22px;
    font-weight: bold;
    z-index: 9999;
    animation: grassFloat 1s ease-out forwards;
}

@keyframes grassFloat {
    0% {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    100% {
        opacity: 0;
        transform: translateY(-70px) scale(1.15);
    }
}

@media (max-width: 600px) {
    .resource-box {
        top: 10px;
        left: 10px;
        padding: 9px 11px;
    }

    #gemCount,
    #grassCount {
        font-size: 14px;
    }

    .header-bar {
        min-height: 75px;
        padding-top: 12px;
    }

    .header-bar h1 {
        font-size: 32px;
    }

    .center-area {
        height: 300px;
        padding-top: 25px;
    }

    #grass {
        width: 190px;
        height: 190px;
    }

    .shop-panel {
        width: 94vw;
        height: 460px;
        border-radius: 28px;
    }

    .categories {
        gap: 6px;
        padding-left: 8px;
        padding-right: 8px;
    }

    .categories button {
        width: 100px;
        height: 42px;
        font-size: 13px;
    }

    .shop-content {
        padding-left: 14px;
        padding-right: 14px;
    }

    .upgrade {
        font-size: 12px;
    }
}
.lumosBoost{color:#ffd700;font-weight:bold}
