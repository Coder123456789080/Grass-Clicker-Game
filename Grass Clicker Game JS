grassImage.addEventListener("mousemove",event=>{
    const rect=grassImage.getBoundingClientRect();
    const x=(event.clientX-rect.left)/rect.width;
    const y=(event.clientY-rect.top)/rect.height;
    noise.setAttribute("seed",(x+y)*100);
    grassImage.style.transform=`translate(${(x-.5)*8}px,${(y-.5)*8}px) scale(1.03)`;
});

grassImage.addEventListener("mouseleave",()=>{
    grassImage.style.transform="translate(0,0) scale(1)";
    noise.setAttribute("seed",0);
});

function incrementGrass(){
    clicks++;
    let gain=(grassPerClick+tempestBonus)*gaiaMultiplier*duosMultiplier;
    if(Math.random()<critChance)gain*=2;
    if(fertileGrass&&clicks%15===0)gain+=10;
    if(goldenWorms&&clicks%50===0)gain+=100;
    if(grassGod&&clicks%3===0)gain+=50;
    if(luckySeeds&&clicks%100===0&&Math.random()<getLuckChance(.25))gain+=1000;
    if(wormFarm&&clicks%10===0&&Math.random()<getLuckChance(.20))gain+=1000;
    if(magicFertilizer&&Math.random()<getLuckChance(getMagicFertilizerChance()))gain*=2;
    grass+=gain;
    showGrassGain(gain);
    updateGrass();
}

function formatNumber(num){
    return Number.isInteger(num)?num:parseFloat(num.toFixed(2));
}

function getLumosGodBonus(basePercent){
    if(lumosLevel===0)return basePercent;
    if(lumosLevel===1)return basePercent+50;
