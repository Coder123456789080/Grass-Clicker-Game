let grass=0;
let grassPerClick=1;
let clicks=0;
let critChance=0;
let goldenWorms=false;
let fertileGrass=false;
let luckySeeds=false;
let chemicalFertilizer=false;
let magicFertilizer=false;
let wormFarm=false;
let grassGod=false;
let canAscend=false;
let ascendedGems=20;
let autoTimers=[];
let gaiaLevel=0,gaiaCost=1,gaiaMultiplier=1;
let neroLevel=0,neroCost=1,neroMultiplier=1;
let tempestLevel=0,tempestCost=1,tempestBonus=0;
let colossusLevel=0,colossusCost=1;
let ignisLevel=0,ignisCost=1;
let costosLevel=0,costosCost=1,costosMultiplier=1;
let duosLevel=0,duosCost=1,duosMultiplier=1;
let riskisLevel=0,riskisCost=1,riskisLuck=0;
let lumosLevel=0,lumosCost=1,lumosMultiplier=1;

const grassImage=document.getElementById("grass");
const noise=document.getElementById("grassNoise");

grassImage.addEventListener("mousemove",event=>{
    const rect=grassImage.getBoundingClientRect();
    const x=(event.clientX-rect.left)/rect.width;
    const y=(event.clientY-rect.top)/rect.height;
    noise.setAttribute("seed",(x+y)*100);
    grassImage.style.transform=`translate(${(x-.5)*8}px,${(y-.5)*8}px) scale(1.03)`;
});

grassImage.addEventListener("mouseleave",()=>{
    grassImage.style.transform="translate(0,0) scale(1)";
    noise.setAttribute("seed",0);
});

function incrementGrass(){
    clicks++;
    let gain=(grassPerClick+tempestBonus)*gaiaMultiplier*duosMultiplier;

    if(Math.random()<critChance)gain*=2;
    if(fertileGrass&&clicks%15===0)gain+=10;
    if(goldenWorms&&clicks%50===0)gain+=100;
    if(grassGod&&clicks%3===0)gain+=50;
    if(luckySeeds&&clicks%100===0&&Math.random()<getLuckChance(.25))gain+=1000;
    if(wormFarm&&clicks%10===0&&Math.random()<getLuckChance(.20))gain+=1000;
    if(magicFertilizer&&Math.random()<getLuckChance(.10))gain*=2;

    grass+=gain;
    showGrassGain(gain);
    updateGrass();
}

function formatNumber(num){
    return Number.isInteger(num)?num:parseFloat(num.toFixed(2));
}

function updateGrass(){
    document.getElementById("grassCount").innerHTML="Grass Seeds: "+formatNumber(grass);
}

function buyUpgrade(cost,action){
    cost=upgradeCost(cost);
    if(grass<cost)return;
    grass-=cost;
    action();
    updateGrass();
}

function buyClickUpgrade(){
    buyUpgrade(50,()=>grassPerClick++);
}

function buyAutoUpgrade(){
    buyUpgrade(100,()=>{
        autoTimers.push(setInterval(()=>addAutoGrass(1),5000));
    });
}

function buyBetterSeeds(){
    buyUpgrade(200,()=>grassPerClick+=2);
}

function buyGrasserV2(){
    buyUpgrade(400,()=>{
        autoTimers.push(setInterval(()=>addAutoGrass(2),3000));
    });
}

function buyCollector(){
    buyUpgrade(800,()=>grassPerClick+=3);
}

function buyRustyMower(){
    buyUpgrade(1000,()=>critChance=.1);
}

function buyWishFertilizer(){
    buyUpgrade(2000,()=>goldenWorms=true);
}

function buyEliteSeeder(){
    buyUpgrade(2500,()=>grassPerClick+=5);
}

function buyRoboticGrasser(){
    buyUpgrade(2800,()=>{
        autoTimers.push(setInterval(()=>addAutoGrass(5),2000));
    });
}

function buyFertileGrass(){
    buyUpgrade(3000,()=>fertileGrass=true);
}

function buyMasterGrasser(){
    buyUpgrade(3500,()=>grassPerClick+=10);
}

function buyLuckySeeds(){
    buyUpgrade(4000,()=>luckySeeds=true);
}

function buyGrassFarmer(){
    buyUpgrade(5000,()=>{
        autoTimers.push(setInterval(()=>addAutoGrass(10),2000));
        unlockAscension();
    });
}

function unlockAscension(){
    canAscend=true;
    const button=document.getElementById("ascendButton");
    button.disabled=false;
    document.getElementById("godsTab").disabled=false;
    document.getElementById("petsTab").disabled=false;
    button.innerHTML="ASCEND<br>Reset Progress For Power";
}

function buyChemicalFertilizer(){
    buyUpgrade(6000,()=>chemicalFertilizer=true);
}

function buyScarecrow(){
    buyUpgrade(6500,()=>grassPerClick+=15);
}

function buyAIGrasser(){
    buyUpgrade(7000,()=>{
        autoTimers.push(setInterval(()=>addAutoGrass(15),1000));
    });
}

function buyMagicFertilizer(){
    buyUpgrade(7500,()=>magicFertilizer=true);
}

function buyWormFarm(){
    buyUpgrade(8000,()=>wormFarm=true);
}

function buyGrassGenie(){
    buyUpgrade(8500,()=>grassPerClick+=20);
}

function buyHumanoidGrasser(){
    buyUpgrade(9000,()=>{
        autoTimers.push(setInterval(()=>addAutoGrass(20),900));
    });
}

function buyGrassGod(){
    if(grass<upgradeCost(10000))return;
    grass-=upgradeCost(10000);
    grassGod=true;
    updateGrass();
}

function buyTimeToGrass(){
    if(grass<10000)return;
    grass-=10000;
    grassPerClick+=30;
    updateGrass();
}

function ascend(){
    if(!canAscend){
        alert("Unlock Grass Farmer first!");
        return;
    }

    autoTimers.forEach(clearInterval);
    autoTimers=[];

    let gemsEarned=Math.floor(grass/1000)-3;
    if(gemsEarned<1)gemsEarned=1;
    if(gemsEarned>10)gemsEarned=10;
    if(ignisLevel>=1)gemsEarned++;

    ascendedGems+=gemsEarned;
    updategems();

    grass=0;
    grassPerClick=1;
    critChance=0;
    goldenWorms=false;
    fertileGrass=false;
    luckySeeds=false;
    chemicalFertilizer=false;
    magicFertilizer=false;
    wormFarm=false;
    grassGod=false;
    clicks=0;

    updateGrass();

    document.querySelector(".categories button:nth-child(2)").disabled=false;
    document.querySelector(".categories button:nth-child(3)").disabled=false;

    alert("You Ascended! You gained "+gemsEarned+" Ascended Gem(s)! Your upgrades were reset and new areas unlocked!");
}

function showCategory(category){
    document.getElementById("upgrades").style.display="none";
    document.getElementById("gods").style.display="none";
    document.getElementById("pets").style.display="none";
    document.getElementById(category).style.display="block";
}

function updategems(){
    document.getElementById("gemCount").innerHTML="Ascended Gems: "+ascendedGems;
}

function buyGaiaUpgrade(){
    if(gaiaLevel>=4||ascendedGems<gaiaCost)return;
    ascendedGems-=gaiaCost;
    gaiaLevel++;
    updateGaia();
    updategems();
}

function updateGaia(){
   const levelText=document.getElementById("gaiaLevel");
   const bonusText=document.getElementById("gaiaBonus");
   const costText=document.getElementById("gaiaCost");

   switch(gaiaLevel){
    case 0:
        gaiaMultiplier=1;
        gaiaCost=1;
        levelText.textContent="Level 0";
        bonusText.textContent="Current Grass Bonus Per Click: 0";
        costText.textContent="1 Gem";
        break;

    case 1:
        gaiaMultiplier= 1.5;
        gaiaCost=3;
        levelText.textContent="Level 1";
        bonusText.textContent="Current Grass Bonus Per Click: 50%";
        costText.textContent="3 Gems";
        break;

    case 2:
        gaiaMultiplier= 3;
        gaiaCost=6;
        levelText.textContent="Level 2";
        bonusText.textContent="Current Grass Bonus Per Click: 300%";
        costText.textcontent="6 Gems";
        break;

    case 3:
        gaiaMultiplier= 6;
        gaiaCost=10;
        levelText.textContent="Level 3";
        bonusText.textContent="Current Grass Bonus Per Click: 600%";
        costText.textContent="10 Gems";
        break;

    case 4:
        gaiaMultiplier= 12;
        gaiaCost=0;
        levelText.textContent="Level 4";
        bonusText.textContent="Current Grass Bonus Per Click: 1200%";
        costText.textContent="MAX LEVEL"
        break;
   }
}

function buyNeroUpgrade(){
    if(neroLevel>=1||ascendedGems<neroCost)return;
    ascendedGems-=neroCost;
    neroLevel=1;
    neroMultiplier=1.05;
    updategems();
}

function addAutoGrass(amount){
    const gain=amount*neroMultiplier*duosMultiplier;
    grass+=gain;
    showGrassGain(gain);
    updateGrass();
}

function buyTempestUpgrade(){
    if(tempestLevel>=1||ascendedGems<tempestCost)return;
    ascendedGems-=tempestCost;
    tempestLevel=1;
    tempestBonus=1;
    updategems();
}

function buyColossusUpgrade(){
    if(colossusLevel>=1||ascendedGems<colossusCost)return;
    ascendedGems-=colossusCost;
    colossusLevel=1;
    critChance+=.05;
    updategems();
}

function buyIgnisUpgrade(){
    if(ignisLevel>=1||ascendedGems<ignisCost)return;
    ascendedGems-=ignisCost;
    ignisLevel=1;
    updategems();
}

function buyCostosUpgrade(){
    if(costosLevel>=1||ascendedGems<costosCost)return;
    ascendedGems-=costosCost;
    costosLevel=1;
    costosMultiplier=.95;
    updateUpgradePrices();
    updategems();
}

function upgradeCost(price){
    return Math.ceil(price*costosMultiplier);
}

