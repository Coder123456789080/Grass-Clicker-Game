function buyDuosUpgrade(){
    if(duosLevel>=1||ascendedGems<duosCost)return;
    ascendedGems-=duosCost;
    duosLevel=1;
    duosMultiplier=1.03;
    updategems();
}

function buyRiskisUpgrade(){
    if(riskisLevel>=1)return;
    if(ascendedGems>=riskisCost){
        ascendedGems-=riskisCost;
        riskisLevel=1;
        riskisLuck=.10;
        updategems();
    }
}

function getluckChance(chance){
    return chance+riskisLuck;
}

function buyLumosUpgrade(){
    if(lumosLevel>=1||ascendedGems<lumosCost)return;

    ascendedGems-=lumosCost;
    lumosLevel=1;
    lumosMultiplier=1.05;

    if(gaiaLevel>=1)gaiaMultiplier*=lumosMultiplier;
    if(neroLevel>=1)neroMultiplier*=lumosMultiplier;
    if(tempestLevel>=1)tempestBonus+=1;
    if(colossusLevel>=1)critChance*=lumosMultiplier;
    if(ignisLevel>=1)ignisLevel=2;
    if(costosLevel>=1)costosMultiplier=.90;
    if(duosLevel>=1)duosMultiplier*=lumosMultiplier;
    if(riskisLevel>=1)riskisLuck*=lumosMultiplier;

    updateUpgradePrices();
    updategems();
}

function showGrassGain(amount){
    const number=document.createElement("div");
    number.className="floatingGrass";
    number.textContent="+"+formatNumber(amount);

    const rect=grassImage.getBoundingClientRect();
    const randomX=Math.random()*100-50;
    const randomY=Math.random()*60-30;

    number.style.left=rect.left+rect.width/2+randomX+"px";
    number.style.top=rect.top+rect.height/2+randomY+"px";

    document.body.appendChild(number);
    setTimeout(()=>number.remove(),1000);
}

updateGrass();
updategems();
updateUpgradePrices();
updateGaia();
